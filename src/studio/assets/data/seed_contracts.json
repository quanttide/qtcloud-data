{
  "contracts": [
    {
      "id": "resolution-archive",
      "name": "决议档案",
      "description": "一决议一 YAML 文件，对齐决议 schema：id/title/content/owner/due/status/vote/source/evidence/history",
      "format": "yaml",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "决议编号（提案按发布周、会议按召开周编号）"
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "决议标题"
        },
        {
          "name": "content",
          "type": "text",
          "required": true,
          "description": "决议内容"
        },
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "description": "责任人（未指定时标记「未指定」，治理视图提示补全）"
        },
        {
          "name": "due",
          "type": "date",
          "required": true,
          "description": "完成期限（缺失时逾期推导跳过）"
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "description": "open / done / overdue"
        },
        {
          "name": "vote",
          "type": "string",
          "required": false,
          "description": "表决记录（poll 标记）"
        },
        {
          "name": "source",
          "type": "string",
          "required": true,
          "description": "溯源：来源提案/纪要编号"
        },
        {
          "name": "evidence",
          "type": "string",
          "required": false,
          "description": "证据链"
        },
        {
          "name": "history",
          "type": "string",
          "required": false,
          "description": "变更历史"
        }
      ],
      "example": "id: 2026-033-001\ntitle: 第33周决议示例\ncontent: 决议内容\nowner: 张工\ndue: 2026-08-15\nstatus: open\nvote: 通过\nsource: 纪要 2026-033\nevidence: —\nhistory: —"
    },
    {
      "id": "governance-view",
      "name": "治理视图",
      "description": "客户端可消费的治理数据：stats / overdue / by_owner / resolutions",
      "format": "json",
      "fields": [
        {
          "name": "stats",
          "type": "object",
          "required": true,
          "description": "聚合统计"
        },
        {
          "name": "overdue",
          "type": "list",
          "required": true,
          "description": "逾期决议（due < today 且未完成）"
        },
        {
          "name": "by_owner",
          "type": "object",
          "required": true,
          "description": "责任人分布"
        },
        {
          "name": "resolutions",
          "type": "list",
          "required": true,
          "description": "决议清单"
        }
      ],
      "example": "{\"stats\": {\"total\": 8}, \"overdue\": [], \"by_owner\": {}, \"resolutions\": []}"
    },
    {
      "id": "weekly-summary",
      "name": "周会决议汇总",
      "description": "周会决议清单 + 质量指标（编号错位 / 辩论记录 / 决议落档）",
      "format": "json",
      "fields": [
        {
          "name": "resolutions",
          "type": "list",
          "required": true,
          "description": "本周决议清单"
        },
        {
          "name": "quality",
          "type": "object",
          "required": true,
          "description": "质量基线：编号错位率 / 辩论记录率 / 决议落档数"
        }
      ],
      "example": "{\"resolutions\": [...], \"quality\": {\"misnumber_rate\": 1.0}}"
    }
  ]
}
